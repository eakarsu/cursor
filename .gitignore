# vscode/ — only track our customizations, ignore the upstream source
vscode/**
!vscode/build/
!vscode/build/gulpfile.extensions.ts
!vscode/build/npm/
!vscode/build/npm/dirs.ts
!vscode/product.json
!vscode/extensions/
!vscode/extensions/ai-assistant/
!vscode/extensions/ai-assistant/**

# Inside the extension, still exclude noise
vscode/extensions/ai-assistant/node_modules/
vscode/extensions/ai-assistant/out/
vscode/extensions/ai-assistant/*.tsbuildinfo

# Generic excludes
node_modules/
__pycache__/
.next/
dist/
build/
coverage/
.cache/
*.log

# Secrets
.env
.env.local
.env.production
.env.development
.env.staging
token.txt
tokens.txt
credentials.json
credentials.yaml
secrets.json
secrets.yaml
*.pem
*.key
*.crt
*.p12

.DS_Store
